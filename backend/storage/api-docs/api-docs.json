                "operationId": "c20faec549c37507e1dc52281a7f7504",
                "responses": {
                    "200": {
                        "description": "ดึงข้อมูลสำเร็จ"
                    }
                }
            }
        },
        "/telemetry/ingest": {
            "post": {
                "tags": [
                    "IoT Telemetry Ingestion"
                ],
                "summary": "ช่องทางรับข้อมูลดิบจาก Node-RED/Sensor",
                "operationId": "cb3bb89a11c460312565716b8ace48ff",
                "parameters": [
                    {
                        "name": "X-API-KEY",
                        "in": "header",
                        "description": "รหัสลับความปลอดภัยอุปกรณ์",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "sensor_id",
                                    "water_level_cm",
                                    "battery_voltage"
                                ],
                                "properties": {
                                    "sensor_id": {
                                        "type": "string",
                                        "example": "PT-01"
                                    },
                                    "timestamp": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-06-08T16:15:00+07:00"
                                    },
                                    "water_level_cm": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 245
                                    },
                                    "battery_voltage": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 3.82
                                    },
                                    "signal_strength_rssi": {
                                        "type": "integer",
                                        "example": -72
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "บันทึกข้อมูลเรียบร้อยแล้ว"
                    },
                    "401": {
                        "description": "API Key ไม่ถูกต้อง"
                    }
                }
            }
        },
