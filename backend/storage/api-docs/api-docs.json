        "/cap/alert": {
            "post": {
                "tags": [
                    "CAP Alerts Integration"
                ],
                "summary": "รับข้อมูลแจ้งเตือนภัยตามมาตรฐาน CAP v1.2 จาก Sri Gateway (XML / JSON)",
                "operationId": "dbc9bd98d74245ace11cf413ab335e2f",
                "requestBody": {
                    "description": "CAP V1.2 XML or JSON payload representing the warning",
                    "required": true,
                    "content": {
                        "application/xml": {
                            "schema": {
                                "type": "string",
                                "example": "<alert>...</alert>"
                            }
                        },
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identifier",
                                    "sender",
                                    "sent",
                                    "status",
                                    "msgType",
                                    "scope",
                                    "info"
                                ],
                                "properties": {
                                    "identifier": {
                                        "type": "string",
                                        "example": "sri-gateway-112233"
                                    },
                                    "sender": {
                                        "type": "string",
                                        "example": "sri-gateway@kku.ac.th"
                                    },
                                    "sent": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-06-16T18:00:00+07:00"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "Actual"
                                    },
                                    "msgType": {
                                        "type": "string",
                                        "example": "Alert"
                                    },
                                    "scope": {
                                        "type": "string",
                                        "example": "Public"
                                    },
