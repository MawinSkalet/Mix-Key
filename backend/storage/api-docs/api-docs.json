{
    "openapi": "3.0.0",
    "info": {
        "title": "Mix-Key Water Monitoring API",
        "description": "API Standard Documentation for Mix-Key Flood Alert System (Mae Chan, Chiang Rai)",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost/api/v1",
            "description": "Local Development API Gateway"
        }
    ],
    "paths": {
        "/stations": {
            "get": {
                "tags": [
                    "Guest APIs"
                ],
                "summary": "ดึงรายชื่อสถานีทั้งหมด (รองรับ GPS)",
                "operationId": "37a43e2a59cc97060c8c67b160738f06",
                "parameters": [
                    {
                        "name": "latitude",
                        "in": "query",
                        "description": "ละติจูดของผู้ใช้ (เช่น 19.98765)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "longitude",
                        "in": "query",
                        "description": "ลองจิจูดของผู้ใช้ (เช่น 99.87654)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "radius",
                        "in": "query",
                        "description": "รัศมีการค้นหา หน่วยกิโลเมตร (เช่น 10)",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ดึงข้อมูลสำเร็จ"
                    }
                }
            }
        },
        "/stations/{id}": {
            "get": {
                "tags": [
                    "Guest APIs"
                ],
                "summary": "ดึงข้อมูลรายละเอียดสถานี",
                "operationId": "da19240f7794d804eaf8f8a4a542e513",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "รหัสสถานี",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ดึงข้อมูลสำเร็จ"
                    },
                    "404": {
                        "description": "ไม่พบข้อมูลสถานี"
                    }
                }
            }
        },
        "/stations/{id}/water-level": {
            "get": {
                "tags": [
                    "Guest APIs"
                ],
                "summary": "ดึงข้อมูลประวัติระดับน้ำย้อนหลัง (มี Aggregation + Pagination)",
                "operationId": "f6df1287d54fb3381e1557cca28f5ace",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "รหัสสถานี",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "range",
                        "in": "query",
                        "description": "ช่วงเวลาของข้อมูล (6h, 1m, 3m, 6m)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "6h"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "หน้าข้อมูล (Pagination)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "จำนวนจุดข้อมูลต่อหน้า",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ดึงข้อมูลประวัติสำเร็จ"
                    }
                }
            }
        },
        "/alerts/active": {
